{
  "name": "xer-browser",
  "productName": "Xer Browser",
  "version": "0.4.0",
  "description": "Privacy-first Chromium-based browser with built-in Claude assistant",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "@mozilla/readability": "^0.6.0",
    "cross-fetch": "^4.1.0"
  },
  "build": {
    "appId": "os.xer.browser",
    "productName": "Xer Browser",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
