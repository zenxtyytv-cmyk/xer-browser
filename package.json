{
  "name": "xer-browser",
  "productName": "Xer Browser",
  "version": "0.1.0",
  "description": "Privacy-first Chromium-based browser with built-in Claude assistant",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {},
  "build": {
    "appId": "os.xer.browser",
    "productName": "Xer Browser",
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": ["AppImage", "deb"] }
  }
}
